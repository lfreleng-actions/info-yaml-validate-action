---
# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: 2025 The Linux Foundation

extends: default

# Vendored from lfit/releng-global-jjb, the legacy copy verbatim for the
# survey to measure against. Reformatting either to satisfy a line-length
# rule would defeat the point of copying it, and would make future
# comparison against upstream harder.
ignore: |
  schema/info-schema.yaml
  schema/info-schema-legacy.yaml

rules:
  empty-lines:
    max-end: 1
  comments:
    # prettier forces 1 space comment separator
    min-spaces-from-content: 1
    level: error
