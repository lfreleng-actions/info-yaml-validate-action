---
# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: 2025 The Linux Foundation

extends: default

# Vendored verbatim from lfit/releng-global-jjb. Reformatting it to satisfy
# a line-length rule would defeat the point of copying it unchanged, and
# would make future comparison against upstream harder.
ignore: |
  schema/info-schema.yaml

rules:
  empty-lines:
    max-end: 1
  comments:
    # prettier forces 1 space comment separator
    min-spaces-from-content: 1
    level: error
